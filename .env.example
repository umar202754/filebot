# Bu faylni .env deb saqlang — Railway'ga Variables bo'limida ham kiriting

# @BotFather dan olingan token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Payme sozlamalari (merchant.payme.uz dan oling)
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key

# Click sozlamalari (merchant.click.uz dan oling)
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

# Admin Telegram ID (statistika va xabarnomalar uchun)
ADMIN_ID=your_telegram_id
